# Copy to .env.local. VITE_* values are included in the browser build.
# Use the SAME existing project values; never put server secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Existing AIService currently requires this legacy anon JWT as well.
VITE_SUPABASE_LEGACY_ANON_KEY=
VITE_KAKAO_MAP_APP_KEY=

# Optional sources / integrations. Match the existing deployment values.
VITE_CSV_BASE_URL=
VITE_ODCLOUD_API_KEY=
VITE_ODCLOUD_BASE_URL=https://api.odcloud.kr/api
# For Vite-only development use the existing deployed AI endpoint.
# /api/ai-summary requires the Cloudflare Pages Functions runtime.
VITE_AI_PROXY_URL=/api/ai-summary
VITE_TOSS_CLIENT_KEY=

# Server-only secrets stay in Supabase / Cloudflare settings, NEVER VITE_*:
# OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, TOSS_SECRET_KEY,
# SGIS_CONSUMER_KEY, SGIS_CONSUMER_SECRET, LEMON_SQUEEZY_API_KEY
